# Copy to .env beside compose.yaml and replace the placeholders.
# Compose reads .env automatically. It is excluded from Git and Docker builds.
LLM_PROVIDER=openai
LLM_MODEL=your-available-openai-model
OPENAI_API_KEY=your-key

# Optional self-hosted Ollama overlay uses this model instead of LLM_MODEL.
OLLAMA_MODEL=llama3.1:8b

# Only needed when explicitly using an existing host/external Ollama instance.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
