# Native Python and Docker Compose read the root .env automatically.
# Exported environment variables override values from .env.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Compose uses this separate variable: localhost inside a container is not the host.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# To switch providers, set LLM_PROVIDER=openai and LLM_MODEL to an available model.
# OPENAI_API_KEY=your-key-here
